%% HeatViT RTL 框架图 · 图 2/4：Tensor Executor 内部——opcode 分发与存储复用
flowchart TD
  EXEC["heatvit_tensor_executor<br/>单描述符执行器：opcode 分发、区域/地址预检、动态 M/N/K 解析"]
  GUARD["heatvit_addr_guard × 4<br/>src0/src1/aux/dst 四操作数区域越界组合预检"]
  MM["heatvit_mem_master（执行器自备）<br/>单笔在途 64-bit 突发协议机（含 abort drain）"]
  ARB["heatvit_div_arbiter<br/>三客户端固定优先级（0＞1＞2）除法仲裁"]
  UDIV["heatvit_udiv<br/>64/64 恢复无符号除法器（1 商位/拍）"]
  EXT["外部 64-bit 三通道"]

  subgraph CHILDREN["8 个子引擎 —— 每描述符经 opcode 只激活 1 个"]
    GEMM["heatvit_gemm_engine<br/>统一 int8 GEMM：tile 装载 / MAC 累加 / 回写与后处理"]
    LAY["heatvit_layout_engine<br/>流式布局引擎：PATCHIFY / COPY_ADD_POS / QKV_UNPACK / HEAD_CONCAT"]
    VEC["heatvit_vector_engine<br/>流式向量引擎：LayerNorm / 残差 / 注意力 Softmax"]
    RED["heatvit_reduce_mean<br/>Selector 特征规约：candidate 轴 / head-lane 轴均值"]
    CON["heatvit_feature_concat<br/>Local/Global 特征拼接"]
    HF["heatvit_head_fuse<br/>三 Head keep 分数加权融合"]
    FIN["heatvit_selector_finalize<br/>单遍扫描：压缩/打包编排 + 唯一状态更新输出"]
    SS["heatvit_selector_softmax<br/>二分 Softmax：int8 logits → Keep 概率 Q0.16"]
  end

  EXEC -->|opcode 分发与握手| CHILDREN
  EXEC -->|地址预检请求| GUARD
  GUARD -->|越界检查结果| EXEC
  CHILDREN -->|7:1 存储请求复用| MM
  MM -->|外部存储三通道| EXT
  GEMM -->|GEMM 自备通道（2:1）| EXT
  VEC -->|除法客户端 0/1| ARB
  SS -->|除法客户端 0| ARB
  RED -->|除法客户端 2| ARB
  HF -->|除法客户端 2| ARB
  FIN -->|除法客户端 2| ARB
  ARB -->|被除数 / 除数| UDIV
  UDIV -->|商 / 余数 / 除零| ARB
