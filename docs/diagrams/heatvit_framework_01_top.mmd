%% HeatViT RTL 框架图 · 图 1/4：顶层控制与数据面
%% 模块级联 + 模块间信号简要描述（非全部信号）。渲染：mermaid.live / GitHub / VSCode Mermaid 插件。
flowchart TD
  HOST["Host · 外部存储控制器（行为模型 / 板上 DDR）"]
  TOP["heatvit_top<br/>协议层：start 锁存四区域基址、错误/中止协议、警告与输出尺度锁存"]
  SCHED["heatvit_scheduler<br/>8 态 FSM 顺序调度 198 条描述符：slot 重定位、K/V 步长补丁、Token 状态维护"]
  ROM["heatvit_descriptor_rom<br/>198 × 320-bit 描述符只读存储（$readmemh 加载）"]
  EXEC["heatvit_tensor_executor<br/>按 opcode 分发单一描述符到 8 个子引擎，区域/地址预检与动态 M/N/K 解析"]

  HOST -->|启动控制与区域基址配置| TOP
  TOP -->|状态与错误| HOST
  HOST -->|64-bit 访存通道| EXEC
  TOP -->|启动 / 中止| SCHED
  SCHED -->|忙 / 完成 / 错误| TOP
  ROM -->|描述符读取| SCHED
  SCHED -->|描述符下发| EXEC
  EXEC -->|完成 / 错误与状态更新| SCHED
  TOP -->|中止 + 区域寄存器| EXEC
  EXEC -->|错误 / 警告 / 中止完成| TOP
